+        timeline_id=self.data.get('id')
+        if (not isinstance(timeline_id,str) or not timeline_id.strip() or timeline_id in ('.','..') or
+            any(c in timeline_id for c in '/\\:') or timeline_id.rstrip(' .')!=timeline_id):
+            raise UserError('Zaman çizelgesi kimliği geçersiz; güvenli proje klasörü oluşturulamaz.')
+        self.meta = load_json(self.folder / 'draft_meta_info.json')
+        if self.data.get('version') != 360000:
+            raise UserError('Bu taslak sürümü doğrulanmadı. Desteklenen JSON sürümü: 360000.')
+        if not isinstance(self.data.get('tracks'), list) or not isinstance(self.data.get('materials'), dict):
+            raise UserError('CapCut zaman çizelgesi bulunamadı.')
+        self.duration = self.data.get('duration')
+        self.fps = self.data.get('fps')
+        if type(self.duration) is not int or self.duration <= 0:
+            raise UserError('Proje boş veya süresi geçersiz.')
+        if not isinstance(self.fps, (int, float)) or not math.isfinite(self.fps) or not 1 <= self.fps <= 240:
+            raise UserError('Geçersiz proje kare hızı.')
+        self.manifest = self.folder / 'Timelines/project.json'
+        self.content_files = [self.file]
+        if self.manifest.exists():
+            manifest = load_json(self.manifest)
+            timelines = [t for t in manifest.get('timelines', []) if not t.get('is_marked_delete')]
+            if len(timelines) != 1 or manifest.get('main_timeline_id') != self.data.get('id'):
+                raise UserError('İlk sürüm yalnızca tek zaman çizelgeli projeleri destekliyor.')
+            mirror = self.folder / 'Timelines' / self.data['id'] / self.file.name
+            if not mirror.exists() or load_json(mirror) != self.data:
+                raise UserError('Ana taslak ile zaman çizelgesi kopyası uyuşmuyor. CapCut’ta kaydedip kapatın.')
+            self.content_files.append(mirror)
+        files = [*self.content_files, self.folder / 'draft_meta_info.json']
+        if self.manifest.exists():
+            files.append(self.manifest)
+        self.hashes = {p: digest(p) for p in files}
+        self.materials = {m['id']: (kind, m) for kind, entries in self.data['materials'].items()
+                          if isinstance(entries, list) for m in entries if isinstance(m, dict) and m.get('id')}
+        self.media_stamps: dict[Path, tuple[int, int]] = {}
+        for track in self.data['tracks']:
+            for seg in track.get('segments', []):
+                timerange(seg.get('target_timerange'))
+
+    @property
+    def name(self) -> str:
+        return self.meta.get('draft_name') or self.folder.name
+
+    def resolve_media(self, material: dict) -> Path:
+        raw = material.get('path', '')
+        if not isinstance(raw, str) or not raw:
+            raise UserError('Klip için yerel medya yolu bulunamadı.')
+        raw = re.sub(r'^##_draftpath_placeholder_[^/\\]+_##', str(self.folder).replace('\\', '/'), raw)
+        if '://' in raw or '##_draftpath_' in raw:
+            raise UserError('Yalnızca indirilen, yerel medya destekleniyor.')
+        path = Path(raw)
+        if not path.is_absolute():
+            path = self.folder / path
+        path = path.resolve()
+        if not path.is_file():
+            raise UserError(f'Medya bulunamadı: {path}')
+        return path
+
+    def watch_media(self, path: Path) -> None:
+        stat = path.stat()
+        self.media_stamps.setdefault(path, (stat.st_size, stat.st_mtime_ns))
+
+    def assert_unchanged(self) -> None:
+        for path, expected in self.hashes.items():
+            if not path.is_file() or digest(path) != expected:
+                raise UserError('Proje analizden sonra değişti. Projeyi yeniden yükleyip analiz edin.')
+        for path, expected in self.media_stamps.items():
+            if not path.is_file() or (path.stat().st_size, path.stat().st_mtime_ns) != expected:
+                raise UserError(f'Medya analizden sonra değişti: {path.name}')
+
+    def sources(self) -> list[tuple[str, int]]:
+        result = []
+        for i, track in enumerate(self.data['tracks']):
+            if track.get('type') not in ('audio', 'video'):
+                continue
+            names = []
+            for seg in track.get('segments', []):
+                kind, m = self.materials.get(seg.get('material_id'), ('', {}))
+                if kind == 'audios' or (kind == 'videos' and m.get('type') == 'video' and m.get('has_audio', True)):
+                    name = m.get('name') or m.get('material_name') or Path(m.get('path', '')).name
+                    if name and name not in names:
+                        names.append(name)
+            if names:
+                title = track.get('name') or ('Ses' if track['type'] == 'audio' else 'Video sesi')
+                result.append((f'{i+1}. {title} · {", ".join(names)[:110]}', i))
+        return result
+
+    def compatibility(self) -> list[str]:
+        issues: set[str] = set()
+        if any(self.meta.get(k) for k in ('cloud_draft_sync', 'draft_is_cloud_temp_draft')):
+            issues.add('Buluta bağlı proje: önce yerel bir kopya oluşturun.')
+        if self.data.get('relationships') or self.data.get('group_container'):
+            issues.add('Klip grupları/bağlantıları henüz desteklenmiyor.')
+        if self.data.get('time_marks') is not None:
+            from timeline_markers import validate_time_marks
+            try:validate_time_marks(self.data['time_marks'],self.duration)
+            except UserError as exc:issues.add(str(exc))
+        if self.data.get('keyframe_graph_list') or any((self.data.get('keyframes') or {}).values()):
+            issues.add('Genel anahtar kareler henüz desteklenmiyor.')
+        for ti, track in enumerate(self.data['tracks']):
+            if track.get('type') not in ('audio', 'video', 'text'):
+                issues.add(f'{ti+1}. katman türü desteklenmiyor: {track.get("type")}')
+            for seg in track.get('segments', []):
+                kind, material = self.materials.get(seg.get('material_id'), ('', {}))
+                if kind not in ('videos', 'audios', 'texts') or material.get('type') == 'draft':
+                    issues.add(f'{ti+1}. katmanda birleşik/eksik/desteklenmeyen materyal var.')
+                if seg.get('speed', 1) != 1 or seg.get('reverse') or seg.get('is_loop'):
+                    issues.add(f'{ti+1}. katmanda hız değişimi, ters oynatma veya döngü var.')
+                if seg.get('common_keyframes') or seg.get('keyframe_refs') or seg.get('lyric_keyframes'):
+                    issues.add(f'{ti+1}. katmanda anahtar kare var.')
+                if seg.get('group_id') or seg.get('caption_info') or (seg.get('responsive_layout') or {}).get('enable'):
+                    issues.add(f'{ti+1}. katmanda bağlı/dinamik yerleşim var.')
+                if (seg.get('render_timerange') or {}).get('duration', 0):
+                    issues.add(f'{ti+1}. katmanda özel render aralığı var.')
+                if kind == 'texts':
+                    if material.get('text_to_audio_ids') or material.get('relevance_segment') or material.get('is_lyric_effect'):
+                        issues.add(f'{ti+1}. katmanda bağlı/animasyonlu altyazı var.')
+                    for key in ('words', 'current_words'):
+                        words = material.get(key) or {}
+                        if words.get('start_time') or words.get('end_time'):
+                            issues.add(f'{ti+1}. katmanda kelime zamanlamalı altyazı var; basit metne dönüştürün.')
+                for ref in seg.get('extra_material_refs', []):
+                    rk, rm = self.materials.get(ref, ('unknown', {}))
+                    safe = rk in ('canvases', 'sound_channel_mappings', 'material_colors', 'placeholder_infos', 'hsl', 'common_mask')
+                    safe |= rk == 'speeds' and rm.get('speed', 1) == 1 and not rm.get('curve_speed')
+                    safe |= rk == 'material_animations' and not rm.get('animations')
+                    safe |= rk == 'audio_fades' and not rm.get('fade_in_duration') and not rm.get('fade_out_duration')
+                    safe |= rk == 'beats' and not rm.get('enable_ai_beats') and not rm.get('user_beats')
+                    safe |= rk == 'vocal_separations' and rm.get('choice', 0) in (0, None) and not rm.get('production_path')
+                    if not safe:
+                        issues.add(f'{ti+1}. katmanda doğrulanmamış efekt/bağlantı: {rk}.')
+                if kind in ('audios', 'videos'):
+                    try:
+                        path = self.resolve_media(material)
+                        self.watch_media(path)
+                        if material.get('type') != 'photo':
+                            sa, sb = timerange(seg.get('source_timerange'))
+                            a, b = timerange(seg['target_timerange'])
+                            if abs((sb-sa)-(b-a)) > 2:
+                                issues.add(f'{ti+1}. katmanda kaynak/hedef süre eşleşmiyor.')
+                    except UserError as exc:
+                        issues.add(str(exc))
+        return sorted(issues)
