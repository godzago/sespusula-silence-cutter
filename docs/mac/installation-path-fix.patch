+def ffmpeg_executable() -> str:
+    exe = ffmpeg_path(APP)
+    if not exe:
+        raise UserError('FFmpeg bulunamadı. Kurulum yönergelerine bakın.')
+    return str(exe)
+
+
+def run_media(args: list[str], cancel: threading.Event, expected_duration: int | None = None) -> str:
+    if cancel.is_set():
+        raise Cancelled('İşlem iptal edildi.')
+    with tempfile.TemporaryFile() as log, tempfile.TemporaryFile() as progress:
+        proc = subprocess.Popen([ffmpeg_executable(), '-nostdin', '-hide_banner', '-progress', 'pipe:1', *args],
+                                stdin=subprocess.DEVNULL, stdout=progress, stderr=log,
+                                creationflags=CREATE_NO_WINDOW)
+        try:
+            while proc.poll() is None:
+                if cancel.wait(0.1):
+                    raise Cancelled('İşlem iptal edildi.')
+            log.seek(0, 2)
+            if log.tell() > 32 * 1024 * 1024:
+                raise UserError('Ses analiz günlüğü çok büyük. Daha kısa bir aralık seçin.')
+            log.seek(0)
+            output = log.read().decode('utf-8', 'replace')
+            if proc.returncode:
+                raise UserError('Medya okunamadı:\n' + output[-1600:])
+            if expected_duration is not None:
+                progress.seek(0)
+                elapsed = re.findall(rb'out_time_us=(\d+)', progress.read())
+                if not elapsed or int(elapsed[-1]) < expected_duration-50_000:
+                    raise UserError('Ses dosyası zaman çizelgesindeki aralıktan kısa veya çözümlenemedi. Medyayı kontrol edin.')
+            return output
+        finally:
+            if proc.poll() is None:
+                proc.kill()
+            proc.wait()
+
+
+def parse_silences(log: str, duration: int) -> list[Cut]:
+    result = []
+    pending = None
+    for event, raw in re.findall(r'silence_(start|end):\s*([-+0-9.eE]+)', log):
+        value = min(duration, max(0, round(float(raw) * US)))
+        if event == 'start':
+            pending = value
+        elif pending is not None:
+            if value > pending:
+                result.append(Cut(pending, value))
+            pending = None
+    if pending is not None and pending < duration:
+        result.append(Cut(pending, duration))
+    return result
+
+
+@dataclass(frozen=True)
+class AnalysisClip:
+    path: Path
+    source_start: int
+    start: int
+    end: int
+
+
+def analysis_clips(project: Project, track_index: int, settings: Settings) -> list[AnalysisClip]:
+    """Shared authority for source-to-timeline mapping in both analysis engines."""
+    a, b = settings.validate(project.duration)
+    project.assert_unchanged()
+    tracks = project.data['tracks']
+    if track_index not in [i for _, i in project.sources()]:
+        raise UserError('Konuşma sesi içeren bir katman seçin.')
+    segments = sorted(tracks[track_index]['segments'], key=lambda s: s['target_timerange']['start'])
+    previous_end = 0
+    clips = []
+    for seg in segments:
+        ta, tb = timerange(seg['target_timerange'])
+        if ta < previous_end:
+            raise UserError('Seçilen ses katmanında üst üste binen klipler var.')
+        previous_end = tb
+        left, right = max(a, ta), min(b, tb)
+        if right <= left:
+            continue
+        if seg.get('speed', 1) != 1 or seg.get('reverse') or seg.get('is_loop'):
+            raise UserError('Analiz kaynağı normal hızda ve düz oynatılıyor olmalı.')
+        kind, material = project.materials.get(seg.get('material_id'), ('', {}))
+        if kind == 'videos' and (material.get('type') != 'video' or not material.get('has_audio', True)):
+            continue
+        if kind not in ('audios', 'videos'):
+            raise UserError('Seçilen katmanda analiz edilemeyen klip var.')
+        sa, sb = timerange(seg.get('source_timerange'))
+        if abs((sb-sa)-(tb-ta)) > 2:
+            raise UserError('Kaynak ses ile zaman çizelgesi süreleri eşleşmiyor.')
+        path = project.resolve_media(material)
+        project.watch_media(path)
+        clips.append(AnalysisClip(path,sa+left-ta,left,right))
+    if not clips:
+        raise UserError('Seçilen aralıkta analiz edilecek ses klibi yok.')
+    return clips
+
+
+def analyze(project: Project, track_index: int, settings: Settings, cancel: threading.Event,
+            progress: Callable[[str], None] = lambda _: None) -> list[Cut]:
+    clips=analysis_clips(project,track_index,settings)
+    cuts=[]
+    for i,clip in enumerate(clips):
+        progress(f'{i+1}/{len(clips)} klip analiz ediliyor: {clip.path.name}')
+        length = clip.end-clip.start
+        # Detect on original channels: opposite-phase stereo must never cancel into silence.
+        log = run_media(['-ss', f'{clip.source_start/US:.6f}', '-t', f'{length/US:.6f}', '-i', str(clip.path),
+                         '-map', '0:a:0', '-vn', '-af', f'silencedetect=noise={settings.threshold}dB:d={settings.minimum}',
+                         '-f', 'null', '-'], cancel, expected_duration=length)
+        # Quantize inward to complete video frames, preserving speech at both boundaries.
+        for raw in parse_silences(log, length):
+            cut = silence_cut(clip.start+raw.start,clip.start+raw.end,settings,project.fps)
+            if cut and cut.start >= clip.start and cut.end <= clip.end:
+                cuts.append(cut)
+    project.assert_unchanged()
+    return normalize_cuts(cuts, project.duration)
+
+
+def normalize_cuts(cuts: list[Cut], duration: int) -> list[Cut]:
+    result: list[Cut] = []
+    for cut in sorted(cuts):
+        if type(cut.start) is not int or type(cut.end) is not int or not 0 <= cut.start < cut.end <= duration:
+            raise UserError('Geçersiz kesim aralığı.')
+        if result and cut.start <= result[-1].end:
+            result[-1] = Cut(result[-1].start, max(result[-1].end, cut.end))
+        else:
+            result.append(cut)
+    if sum(c.duration for c in result) >= duration:
+        raise UserError('Projenin tamamı silinemez. Konuşma kaynağını ve ses eşiğini kontrol edin.')
+    return result
+
+
+def map_time(value: int, cuts: list[Cut]) -> int:
+    return value - sum(max(0, min(value, c.end)-c.start) for c in cuts)
+
+
+def edit_timeline(project: Project, cuts: list[Cut], *, allow_empty: bool=False) -> dict:
+    issues = project.compatibility()
+    if issues:
+        raise UserError('Güvenli çıktı için önce şu yapılar sadeleştirilmeli:\n' + '\n'.join(issues))
+    cuts = normalize_cuts(cuts, project.duration)
+    if not cuts and not allow_empty:
+        raise UserError('Silmek için en az bir aralık seçin.')
+    data = copy.deepcopy(project.data)
+    starts=[c.start for c in cuts];ends=[c.end for c in cuts]
+    prefix=[0]
+    for c in cuts:prefix.append(prefix[-1]+c.duration)
+    def mapped(value):
+        i=bisect_right(ends,value)
+        return value-prefix[i]-(max(0,value-starts[i]) if i<len(cuts) else 0)
+    for track in data['tracks']:
+        edited = []
+        for seg in track.get('segments', []):
+            a, b = timerange(seg['target_timerange'])
+            pieces=[];cursor=a
+            for k in range(bisect_right(ends,a),bisect_left(starts,b)):
+                cut=cuts[k]
+                if cut.start>cursor:pieces.append((cursor,cut.start))
+                cursor=max(cursor,cut.end)
+            if cursor<b:pieces.append((cursor,b))
+            for j, (x,y) in enumerate(pieces):
+                item = copy.deepcopy(seg)
+                if j or (x,y) != (a,b):
+                    item['id'] = uid()
+                item['target_timerange'] = {'start': mapped(x), 'duration': y-x}
+                kind, material = project.materials[seg['material_id']]
+                if item.get('source_timerange') and material.get('type') != 'photo':
+                    sa, sb = timerange(seg['source_timerange'])
+                    item['source_timerange'] = {'start': sa+x-a, 'duration': y-x}
+                edited.append(item)
+        track['segments'] = sorted(edited, key=lambda s: s['target_timerange']['start'])
+    data['duration'] = project.duration-sum(c.duration for c in cuts)
+    if data.get('time_marks') is not None:
+        from timeline_markers import remap_time_marks
+        data['time_marks']=remap_time_marks(data['time_marks'],cuts,project.duration)
+    if not any(t['segments'] for t in data['tracks']):
+        raise UserError('Kesimler bütün içeriği siliyor.')
+    if data.get('config', {}).get('export_range'):
+        data['config']['export_range'] = None
+    data['update_time'] = int(time.time()*US)
+    return data
+
+
+def capcut_running() -> bool:
+    return capcut_is_running()
+
+
+def replace_internal_paths(value, old: Path, new: Path):
+    if isinstance(value, str):
+        for before, after in ((str(old), str(new)), (old.as_posix(), new.as_posix())):
+            if value == before or value.startswith(before+'\\') or value.startswith(before+'/'):
+                return after + value[len(before):]
+        return value
+    if isinstance(value, dict):
+        return {k: replace_internal_paths(v, old, new) for k,v in value.items()}
+    if isinstance(value, list):
+        return [replace_internal_paths(v, old, new) for v in value]
+    return value
+
+
+def create_copy(project: Project, cuts: list[Cut], cancel: threading.Event,
+                index: Path = DEFAULT_INDEX, check_running: bool = True,
+                review: dict | None = None, captions: list[dict] | None = None,
+                markers: list[dict] | None = None) -> Path:
+    """Publish a new sibling folder, then register it; original project is never written."""
+    if check_running and capcut_running():
+        raise UserError('Kopya oluştururken CapCut kapalı olmalı. Kaydedip CapCut’ı kapatın; sonra tekrar deneyin.')
+    if cancel.is_set():
+        raise Cancelled('İşlem iptal edildi.')
+    project.assert_unchanged()
+    data = edit_timeline(project, cuts,allow_empty=True)
+    from timeline_markers import add_repeat_markers
+    marker_report=add_repeat_markers(data,markers or [],cuts,project.duration)
+    caption_cues=[]
+    if captions is not None:
+        from captions import add_caption_track
+        caption_cues=add_caption_track(data,captions)
+    # Reject junctions/reparse points, including files, before traversing a user project.
+    for root, dirs, files in os.walk(project.folder, followlinks=False):
+        for name in dirs+files:
+            p = Path(root)/name
+            if p.is_symlink() or getattr(p.lstat(), 'st_file_attributes', 0) & 0x400:
+                raise UserError(f'Proje içinde yönlendirilmiş dosya/klasör desteklenmiyor: {p}')
+    project_id, timeline_id = uid(), uid()
+    output = project.folder.parent / ('Sessizlik-' + time.strftime('%Y%m%d-%H%M%S') + '-' + project_id[:6])
+    stage = project.folder.parent / ('.sessizlik-hazirlaniyor-' + project_id)
+    published = False
+    try:
+        def copy_file(src, dst):
+            if cancel.is_set():
+                raise Cancelled('İşlem iptal edildi.')
+            return shutil.copy2(src,dst)
+        shutil.copytree(project.folder, stage, copy_function=copy_file)
+        old_timeline = data['id']
+        data = replace_internal_paths(data,project.folder,output)
+        data['id'] = timeline_id
+        name = project.name + ' · Sessizlik temizlendi'
+        data['name'] = name
+        now = int(time.time()*US)
+        meta = replace_internal_paths(copy.deepcopy(project.meta),project.folder,output)
+        meta.update(draft_id=project_id, draft_name=name, draft_fold_path=output.as_posix(),
+                    draft_root_path=str(output.parent), tm_duration=data['duration'], tm_draft_create=now,
+                    tm_draft_modified=now, tm_draft_removed=0, cloud_draft_sync=False,
+                    cloud_draft_cover=False, draft_is_cloud_temp_draft=False,
+                    draft_cloud_last_action_download=False, draft_need_rename_folder=False)
+        # Remove recovery copies in the NEW folder so stale edits cannot override the new timeline.
+        for p in list(stage.rglob('*')):
+            if p.is_file() and (p.suffix in ('.bak','.tmp') or p.name == 'mini_draft.json'):
+                p.unlink()
+        if project.manifest.exists():
+            manifest = load_json(stage/'Timelines/project.json')
+            old_folder = stage/'Timelines'/old_timeline
+            new_folder = stage/'Timelines'/timeline_id
+            old_folder.rename(new_folder)
+            manifest.update(id=uid(), main_timeline_id=timeline_id, create_time=now, update_time=now)
+            for t in manifest['timelines']:
+                if t['id'] == old_timeline:
+                    t.update(id=timeline_id, create_time=now, update_time=now)
+            atomic_json(stage/'Timelines/project.json',manifest)
+            atomic_json(new_folder/project.file.name,data)
+            layout = stage/'timeline_layout.json'
+            if layout.exists():
+                text = layout.read_text(encoding='utf-8').replace(old_timeline,timeline_id)
+                layout.write_text(text,encoding='utf-8')
+        atomic_json(stage/project.file.name,data)
+        atomic_json(stage/'draft_meta_info.json',meta)
+        if caption_cues:
+            from captions import srt_text
+            (stage/'otomatik_altyazi.srt').write_text(srt_text(caption_cues),encoding='utf-8-sig')
+        elif cuts:
+            # A tool-created SRT copied from the input still describes the old timeline.
+            (stage/'otomatik_altyazi.srt').unlink(missing_ok=True)
+        atomic_json(stage/'sessizlik_raporu.json', {
+            'source_project': str(project.folder), 'source_hash': project.hashes[project.file],
+            'original_duration_us':project.duration,'duration_us':data['duration'],
+            'cuts_us': [[c.start,c.end] for c in normalize_cuts(cuts,project.duration)],
+            'capcut_open_verified': False, 'tool_version': VERSION, 'review': review,
+            'repeat_markers':marker_report,
+            'captions':{'enabled':bool(caption_cues),'count':len(caption_cues),'language':'tr',
+                        'editable_text_track':bool(caption_cues),'cues':caption_cues}})
+        # Read back everything before publication. Also catches mirror and duration mistakes.
+        verify = Project(stage)
+        if verify.duration != data['duration']:
+            raise UserError('Yazılan kopyanın süresi doğrulanamadı.')
+        if cancel.is_set():
+            raise Cancelled('İşlem iptal edildi.')
+        project.assert_unchanged()
+        if check_running and capcut_running():
+            raise UserError('CapCut açıldı; kopya yayımlanmadı. CapCut’ı kapatıp tekrar deneyin.')
+        # Prepare registration before publishing. Preserve every existing entry and a byte-exact backup.
+        registration = None
+        if index.exists():
+            before = index.read_bytes()
+            registration = load_json(index)
+            if not isinstance(registration.get('all_draft_store'), list):
+                raise UserError('CapCut proje listesi biçimi tanınmadı.')
+            entry = {k:v for k,v in meta.items() if k not in ('draft_materials','draft_segment_extra_info')}
+            entry.update(draft_json_file=(output/project.file.name).as_posix(),
+                         draft_cover=(output/'draft_cover.jpg').as_posix())
+            registration['all_draft_store'].insert(0,entry)
+            if type(registration.get('draft_ids')) is int:
+                registration['draft_ids'] += 1
+            if index.read_bytes() != before:
+                raise UserError('CapCut proje listesi değişti. Tekrar deneyin.')
+            backup = index.with_name(index.name+'.sessizlik-'+project_id+'.bak')
+            backup.write_bytes(before)
+        stage.rename(output)
+        published = True
+        if registration is not None:
+            try:
+                if index.read_bytes() != before:
+                    raise UserError('CapCut proje listesi değişti; kopya kaydı eklenmedi.')
+                atomic_json(index,registration)
+            except Exception as exc:
+                raise UserError(f'Kopya hazır ama CapCut listesine eklenemedi: {output}\n{exc}') from exc
+        return output
+    finally:
+        # Only this invocation's exact temporary directory can be removed.
+        if not published and stage.exists() and stage.parent == project.folder.parent and stage.name == '.sessizlik-hazirlaniyor-'+project_id:
+            shutil.rmtree(stage)
+
+
+def preview(project: Project, track_index: int, cut: Cut, output: Path,
+            cancel: threading.Event, after: bool = False, full: bool = False) -> None:
+    project.assert_unchanged()
+    if not 0<=cut.start<cut.end<=project.duration:
+        raise UserError('Dinlenecek aralık proje içinde olmalı.')
+    # Include context around each boundary; after mode removes the candidate interval.
+    a, b = max(0,cut.start-US), min(project.duration,cut.end+US)
+    if full:
+        windows = [(cut.start,cut.end)]
+    elif after:
+        windows = [(a,cut.start),(cut.end,b)]
+    elif b-a > 12*US:
+        windows = [(a,cut.start+US),(cut.end-US,b)]
+    else:
+        windows = [(a,b)]
+    segments=sorted(project.data['tracks'][track_index]['segments'],key=lambda s:s['target_timerange']['start'])
+    # None represents a real gap in the selected track; keep it audible as silence.
+    clips = []
+    for left,right in windows:
+        cursor=left
+        for seg in segments:
+            ta,tb=timerange(seg['target_timerange'])
+            x,y=max(left,ta),min(right,tb)
+            if y<=x:
+                continue
+            if x>cursor:
+                clips.append((None,cursor,x))
+            clips.append((seg,x,y));cursor=y
+        if cursor<right:
+            clips.append((None,cursor,right))
+    if not any(seg for seg,_,_ in clips):
+        raise UserError('Bu aralıkta dinlenebilecek ses bulunamadı.')
+    # Render each overlap individually and concatenate WAV PCM through Python's wave module.
+    import wave
+    with tempfile.TemporaryDirectory(prefix='capcut-preview-') as temp:
+        chunks = []
+        for i,(seg,x,y) in enumerate(clips):
+            frames=round((y-x)*22050/US)
+            if seg is None:
+                chunks.append((None,frames))
+                continue
+            _,material=project.materials[seg['material_id']]
+            path=project.resolve_media(material)
+            source=seg['source_timerange']['start']+x-seg['target_timerange']['start']
+            piece=Path(temp)/f'{i}.wav'
+            run_media(['-y','-ss',f'{source/US:.6f}','-t',f'{(y-x)/US:.6f}','-i',str(path),
+                       '-map','0:a:0','-vn','-ar','22050','-ac','1','-c:a','pcm_s16le',str(piece)],cancel)
+            chunks.append((piece,frames))
+        with wave.open(str(output),'wb') as dest:
+            dest.setnchannels(1);dest.setsampwidth(2);dest.setframerate(22050)
+            for path,frames in chunks:
+                if path is None:
+                    dest.writeframes(b'\0'*(frames*2))
+                else:
+                    with wave.open(str(path),'rb') as src:
+                        pcm=src.readframes(frames)
+                        dest.writeframes(pcm+b'\0'*max(0,frames*2-len(pcm)))
