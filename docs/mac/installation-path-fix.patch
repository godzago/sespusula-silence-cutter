+                              ffmpeg_path,capcut_is_running,VERSION)
+
+HOME = Path.home()
+APP = application_home()
+DEFAULT_INDEX = default_capcut_index()
+US = 1_000_000
+CREATE_NO_WINDOW = getattr(subprocess, 'CREATE_NO_WINDOW', 0)
