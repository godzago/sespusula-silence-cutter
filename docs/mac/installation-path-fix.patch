+
+
+def load_json(path: Path) -> dict:
+    try:
+        value = json.loads(path.read_text(encoding='utf-8-sig'))
+    except (OSError, UnicodeError, ValueError) as exc:
+        raise UserError(f'JSON okunamadı: {path}\n{exc}') from exc
+    if not isinstance(value, dict):
+        raise UserError(f'Proje biçimi tanınmadı: {path}')
+    return value
+
+
+def digest(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def atomic_json(path: Path, data: dict) -> None:
+    fd, name = tempfile.mkstemp(prefix=path.name + '.', suffix='.tmp', dir=path.parent)
+    try:
+        with os.fdopen(fd, 'w', encoding='utf-8', newline='\n') as stream:
+            json.dump(data, stream, ensure_ascii=False, separators=(',', ':'), allow_nan=False)
+            stream.flush()
+            os.fsync(stream.fileno())
+        # Windows readers/antivirus can briefly hold a handle without delete sharing.
+        for attempt in range(8):
+            try:
+                os.replace(name, path)
+                break
+            except PermissionError:
+                if attempt==7:
+                    raise
+                time.sleep(.01*(attempt+1))
+    finally:
+        Path(name).unlink(missing_ok=True)
+
+
+def uid() -> str:
+    return str(uuid.uuid4()).upper()
+
+
+def project_content_file(folder: Path) -> Path:
+    """Preserve the saved timeline filename on both platforms."""
+    existing = [folder / name for name in ('draft_content.json', 'draft_info.json') if (folder / name).is_file()]
+    if len(existing) != 1:
+        raise UserError(f'Klasörde tek bir draft_content.json veya draft_info.json olmalı: {folder}')
+    return existing[0]
+
+
+def has_project_content(folder: Path) -> bool:
+    return any((folder / name).is_file() for name in ('draft_content.json', 'draft_info.json'))
+
+
+def discover_projects(index: Path | None = None) -> list[tuple[str, Path]]:
+    """Follow registered paths; the project storage can be on another drive."""
+    found: dict[Path, str] = {}
+    indexes=[index] if index is not None else capcut_indexes(HOME)
+    roots = {p.parent for p in indexes}
+    for candidate_index in indexes:
+        if candidate_index.is_file():
+            for item in load_json(candidate_index).get('all_draft_store', []):
+                if item.get('draft_root_path'):
+                    roots.add(Path(item['draft_root_path']))
+                p = Path(item.get('draft_fold_path', ''))
+                if not item.get('tm_draft_removed') and has_project_content(p):
+                    found[p.resolve()] = item.get('draft_name') or p.name
+    for root in roots:
+        if root.is_dir():
+            for p in root.iterdir():
+                if p.is_dir() and not p.name.startswith('.') and has_project_content(p):
+                    try:
+                        meta = load_json(p / 'draft_meta_info.json')
+                        if not meta.get('tm_draft_removed'):
+                            found[p.resolve()] = meta.get('draft_name') or p.name
+                    except UserError:
+                        continue
+    return sorted(((n, p) for p, n in found.items()), key=lambda x: x[0].casefold())
