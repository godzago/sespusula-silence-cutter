+
+def timerange(value: dict | None) -> tuple[int, int]:
+    if not isinstance(value, dict):
+        raise UserError('Eksik zaman aralığı.')
+    a, duration = value.get('start'), value.get('duration')
+    if type(a) is not int or type(duration) is not int or a < 0 or duration <= 0:
+        raise UserError('Geçersiz klip zaman aralığı.')
+    return a, a + duration
+
+
+@dataclass(frozen=True, order=True)
+class Cut:
+    start: int
+    end: int
+
+    @property
+    def duration(self) -> int:
+        return self.end - self.start
+
+
+@dataclass(frozen=True)
+class Settings:
+    threshold: float = -35.0
+    minimum: float = 0.5
+    padding: float = 0.1
+    start: float = 0.0
+    end: float | None = None
+    maximum: float | None = None
+    lead_padding: float | None = None
+    minimum_cut: float = 0.08
+    auto_jump_cut: bool = False
+    next_speech_padding: float | None = None
+
+    def validate(self, duration: int) -> tuple[int, int]:
+        if type(self.auto_jump_cut) is not bool:
+            raise UserError('Otomatik jump cut seçimi geçersiz.')
+        if self.auto_jump_cut:
+            if type(duration) is not int or duration<=0:
+                raise UserError('Zaman çizelgesi süresi geçersiz.')
+            if self.next_speech_padding is not None and (not isinstance(self.next_speech_padding,(int,float)) or
+                    not math.isfinite(self.next_speech_padding) or not 0<=self.next_speech_padding<=5):
+                raise UserError('Yeni konuşma öncesi pay 0–5 saniye arasında olmalı.')
+            return 0,duration
+        values = [self.threshold, self.minimum, self.padding, self.start]
+        values.append(self.minimum_cut)
+        if self.lead_padding is not None:
+            values.append(self.lead_padding)
+        if self.end is not None:
+            values.append(self.end)
+        if self.maximum is not None:
+            values.append(self.maximum)
+        if not all(math.isfinite(x) for x in values):
+            raise UserError('Ayarlar sonlu sayılar olmalı.')
+        if not -100 <= self.threshold <= -1:
+            raise UserError('Ses eşiği −100 ile −1 dB arasında olmalı.')
+        if not 0.02 <= self.minimum <= 60 or not 0 <= self.padding <= 5:
+            raise UserError('Minimum sessizlik 0,02–60 sn; koruma payı 0–5 sn olmalı.')
+        if not 0 <= self.minimum_cut <= 5 or (self.lead_padding is not None and not 0 <= self.lead_padding <= 5):
+            raise UserError('Kelime başı payı ve en kısa kesim 0–5 sn olmalı.')
+        if self.maximum is not None and self.maximum < self.minimum:
+            raise UserError('En uzun boşluk, en kısa boşluktan küçük olamaz.')
+        a = 0 if self.auto_jump_cut else round(self.start * US)
+        b = duration if self.auto_jump_cut or self.end is None else round(self.end * US)
+        if not 0 <= a < b <= duration:
+            raise UserError('İşlem aralığı proje içinde olmalı; bitiş başlangıçtan büyük olmalı.')
+        return a, b
+
+    def accepts_silence(self, duration: int) -> bool:
+        return (duration >= round(self.minimum * US) and
+                (self.maximum is None or duration <= round(self.maximum * US)))
+
+
+def silence_cut(start: int, end: int, settings: Settings, fps: float) -> Cut | None:
+    """Keep the previous word's tail and the next word's onset; quantize inward."""
+    if not settings.accepts_silence(end-start):
+        return None
+    lead = settings.padding if settings.lead_padding is None else settings.lead_padding
+    a = round(math.ceil((start+settings.padding*US)*fps/US-1e-8)*US/fps)
+    b = round(math.floor((end-lead*US)*fps/US+1e-8)*US/fps)
+    if b > a and b-a >= round(settings.minimum_cut*US):
+        return Cut(a,b)
+    return None
